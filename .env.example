# =============================================================================
#  StaX — modele de configuration
# =============================================================================
#  Ce fichier ne contient QUE des noms de variables. Aucune valeur reelle,
#  aucun secret, aucune cle. Copiez-le en `.env.local` pour le developpement,
#  et renseignez les valeurs de production via les secrets Cloudflare
#  (`wrangler secret put`) et les secrets GitHub Actions.
# =============================================================================

# --- Environnement ------------------------------------------------------------
STAX_ENV=
NODE_ENV=

# --- URLs publiques -----------------------------------------------------------
NEXT_PUBLIC_PLATFORM_URL=
NEXT_PUBLIC_SITES_DOMAIN=
NEXT_PUBLIC_DEFAULT_LOCALE=
PLATFORM_URL=
SITES_DOMAIN=
PREVIEW_DOMAIN=

# --- Supabase -----------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_ANON_KEY est publique par conception : toutes les tables
# qu'elle atteint sont protegees par Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SECRET — ne doit JAMAIS etre expose au navigateur ni prefixe NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Secret applicatif --------------------------------------------------------
# 32 octets minimum. Utilise pour le HMAC des codes d'activation, des jetons de
# preview et des jetons CSRF. Generer avec : openssl rand -base64 48
STAX_SECRET_KEY=

# --- Stripe (paiements de la plateforme) --------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# --- Cloudflare ---------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_SAAS_FALLBACK_ORIGIN=

# --- Cloudflare Turnstile (anti-spam) -----------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- E-mails transactionnels --------------------------------------------------
# EMAIL_PROVIDER : console | resend | postmark
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# --- Compte platform_owner initial --------------------------------------------
# ADMIN_BOOTSTRAP_PASSWORD est fourni uniquement au moment du provisioning,
# via un secret serveur. Il ne doit jamais etre ecrit dans le depot, dans une
# migration, dans un seed, ni dans un journal applicatif.
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Identite legale de l'editeur --------------------------------------------
# Aucune valeur par defaut : tant que ces champs sont vides, les pages legales
# affichent des marqueurs explicites et la production refuse de demarrer.
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_RCS=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_HOST=
LEGAL_HOST_ADDRESS=
LEGAL_DPO_CONTACT=
LEGAL_MEDIATOR=
SUPPORT_EMAIL=
SUPPORT_PHONE=
# Autorise temporairement une production avec des mentions legales incompletes.
LEGAL_ALLOW_INCOMPLETE=

# --- Politique commerciale ----------------------------------------------------
REFUND_WINDOW_DAYS=
DOMAIN_REFUND_DEDUCTION_CENTS=
MAINTENANCE_GRACE_PERIOD_DAYS=
MAINTENANCE_SUSPENSION_RETENTION_DAYS=
MAINTENANCE_ARCHIVE_RETENTION_DAYS=
