{
  "name": "@stax/site-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Contrat d'edition StaX : stax.manifest.json, validation du contenu, bundle publie dans le depot du site, protocole d'apercu.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@stax/config": "workspace:*",
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
