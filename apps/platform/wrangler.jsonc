{
  // Configuration Cloudflare Workers de l application Nemasus, pour les
  // deploiements lances a la main (`pnpm --filter @nemasus/platform
  // deploy:production`). Le deploiement habituel passe par Workers Builds et
  // le `wrangler.jsonc` de la racine du depot.
  // Les secrets ne figurent JAMAIS ici : ils sont poses dans le tableau de
  // bord Cloudflare ou par `wrangler secret put`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nemasus-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": { "mode": "smart" },
  "vars": {
    "NEMASUS_ENV": "development"
  },
  "env": {
    "preview": {
      "name": "nemasus-platform-preview",
      "vars": {
        "NEMASUS_ENV": "preview"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true }
    },
    "production": {
      // Meme Worker que celui deploye par Workers Builds (wrangler.jsonc a la
      // racine du depot) : les deux configurations doivent rester alignees.
      "name": "nemasus",
      "keep_vars": true,
      "vars": {
        "NEMASUS_ENV": "production",
        "NEXT_PUBLIC_SUPABASE_URL": "https://tkgavassmicxghrvseue.supabase.co",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRrZ2F2YXNzbWljeGdocnZzZXVlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTAwNTc2MTEsImV4cCI6MjEwNTYzMzYxMX0.CC4f5HtrruuClNPrEOl8Cx94Mhpsh7KblAn0iw20rXE"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true },
      "placement": { "mode": "smart" }
    }
  }
}
