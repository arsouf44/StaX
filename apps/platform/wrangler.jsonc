{
  // Configuration Cloudflare Workers de l application Nemasus.
  // Les secrets ne figurent JAMAIS ici : ils sont poses par
  // `wrangler secret put` ou par les secrets GitHub Actions.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nemasus-platform",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": { "mode": "smart" },
  "vars": {
    "NEMASUS_ENV": "development"
  },
  "env": {
    "preview": {
      "name": "nemasus-platform-preview",
      "vars": {
        "NEMASUS_ENV": "preview"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true }
    },
    "production": {
      "name": "nemasus-platform",
      "vars": {
        "NEMASUS_ENV": "production"
      },
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "observability": { "enabled": true },
      "placement": { "mode": "smart" }
    }
  }
}
