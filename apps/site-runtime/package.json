    "@stax/site-engine": "workspace:*",
    "@stax/types": "workspace:*",
    "@stax/validation": "workspace:*",
    "@supabase/supabase-js": "2.116.0",
    "hono": "4.13.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wrangler": "4.132.0"
  }
