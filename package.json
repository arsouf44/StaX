{
  "name": "stax",
  "version": "0.1.0",
  "private": true,
  "description": "StaX — plateforme SaaS francaise de creation, vente, livraison et gestion de sites web professionnels.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.11.0"
  },
  "scripts": {
    "dev": "pnpm --filter @stax/platform dev",
    "dev:site": "pnpm --filter @stax/site-runtime dev",
    "build": "pnpm -r --sequential build",
    "build:platform": "pnpm --filter @stax/platform build",
    "build:cf": "pnpm --filter @stax/platform build:cf && pnpm --filter @stax/site-runtime build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,yml,yaml}\"",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:reset": "supabase db reset",
    "db:types": "tsx scripts/gen-db-types.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts",
    "legal:check": "tsx scripts/check-legal-config.ts",
    "deploy:preview": "pnpm build:cf && pnpm --filter @stax/platform deploy:preview && pnpm --filter @stax/site-runtime deploy:preview",
    "deploy:production": "pnpm build:cf && pnpm --filter @stax/platform deploy:production && pnpm --filter @stax/site-runtime deploy:production",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "22.19.1",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.0",
    "globals": "16.5.0",
    "prettier": "3.9.7",
    "tsx": "4.21.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "3.2.7"
  }
}
